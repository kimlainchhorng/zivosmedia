# Force LF line endings for all text files.
# This beats core.autocrlf=true so Windows/OneDrive checkouts stay on LF
# and test assertions using \n don't break on Windows.
* text eol=lf

# Binaries — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.mp4  binary
*.mov  binary
*.mp3  binary
*.wav  binary
