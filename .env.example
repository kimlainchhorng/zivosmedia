# ============================================================
# ZIVO — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Public anon key (safe to expose in frontend JS)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key — BACKEND ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional comma-separated preview/staging origins for Supabase Edge Function CORS.
# Leave empty in strict production.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_SUFFIXES=

# ── Stripe ──────────────────────────────────────────────────
# Publishable key (safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key — BACKEND ONLY
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Bakong KHQR / ABA ───────────────────────────────────────────────────────
# Public static merchant KHQR string. Customers can already see this QR, so it
# is safe for frontend use. Used to generate exact-amount ride QR codes.
VITE_KHQR_STATIC_MERCHANT_QR=000201...
# Same static merchant KHQR for Edge Functions to validate the receiving account.
KHQR_STATIC_MERCHANT_QR=000201...
# Supabase Edge Function secret for official Bakong payment verification.
BAKONG_TOKEN=<bakong-open-api-token>
# Optional Telegram receipt bridge for ABA incoming payment messages.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>

# ── Google ──────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# ── Mapbox ──────────────────────────────────────────────────
# Public token (safe for frontend)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Secret token — BACKEND ONLY
MAPBOX_SECRET_TOKEN=sk.eyJ...

# ── Twilio (SMS / WhatsApp) ──────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── LiveKit (Video / WebRTC) ─────────────────────────────────
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
VITE_LIVEKIT_URL=wss://<project>.livekit.cloud

# ── TravelPayouts / Duffel ───────────────────────────────────
VITE_TRAVELPAYOUTS_MARKER=<marker>
DUFFEL_API_KEY=duffel_live_...

# ── Meta / Facebook ──────────────────────────────────────────
VITE_META_PIXEL_ID=<pixel-id>

# ── App ──────────────────────────────────────────────────────
VITE_APP_URL=https://myzivo.com
VITE_AVIASALES_WL_BASE_URL=https://aviasales.com
# Public-facing canonical origin (used by share-link builders, OG tags, deep links)
VITE_PUBLIC_ORIGIN=https://myzivo.com
# Mobile app store URLs (rendered by smart banners + footer "Get the app" CTAs)
VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.zivo.app
VITE_IOS_APP_STORE_URL=https://apps.apple.com/app/zivo/id<id>

# ── Web Push / VAPID ─────────────────────────────────────────
# Public key for browser push subscriptions (paired with the private key
# stored as a Supabase function secret VAPID_PRIVATE_KEY)
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# ── WebRTC TURN (live calls / streaming) ─────────────────────
# Comma-separated list of TURN/STUN server URLs (turn:..., turns:..., stun:...)
VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
VITE_WEBRTC_TURN_USERNAME=<turn-username>
VITE_WEBRTC_TURN_CREDENTIAL=<turn-credential>

# ── Sticker Asset CDN ────────────────────────────────────────
# Origin that hosts the sticker pack assets (defaults to public Supabase
# storage bucket; override for self-hosted CDN)
VITE_STICKER_ASSET_ORIGIN=https://<project-ref>.supabase.co/storage/v1/object/public/stickers
