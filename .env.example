# ============================================================
# ZIVO — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Public publishable/anon key (safe to expose in frontend JS)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend-compatible anon JWT for Edge Functions, scripts, and pg_cron auth.
# Keep separate from VITE_SUPABASE_PUBLISHABLE_KEY because Edge Function JWT
# verification and database cron jobs may still require the legacy anon JWT.
SUPABASE_ANON_KEY=eyJ...anon...
# Supabase CLI access token for production readiness checks only.
# Keep real tokens private and rotate them if they are ever exposed.
SUPABASE_ACCESS_TOKEN=sbp_...

# Secret/service role key — BACKEND ONLY, never expose to browser or VITE_ env
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Optional comma-separated preview/staging origins for Supabase Edge Function CORS.
# Leave empty in strict production.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_SUFFIXES=

# Transactional email / OTP delivery (Supabase Edge Functions only)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=info@hizivo.com
RESEND_FROM_NAME=ZIVO
# Secret pepper for OTP code hashes. Generate a random 32+ byte secret.
OTP_CODE_PEPPER=<random-base64-secret>

# ── Stripe ──────────────────────────────────────────────────
# Publishable key (safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key — BACKEND ONLY
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Bakong KHQR / ABA ───────────────────────────────────────────────────────
# Public static merchant KHQR string. Customers can already see this QR, so it
# is safe for frontend use. Used to generate exact-amount ride QR codes.
VITE_KHQR_STATIC_MERCHANT_QR=000201...
# Same static merchant KHQR for Edge Functions to validate the receiving account.
KHQR_STATIC_MERCHANT_QR=000201...
# Supabase Edge Function secret for official Bakong payment verification.
BAKONG_TOKEN=<bakong-open-api-token>
# Optional Telegram receipt bridge for ABA incoming payment messages.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>

# ── Google ──────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# Google Ads API (server-side only; used by Supabase Edge Functions)
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Optional manager account Customer ID, digits only, when using an MCC login.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=<developer-token>
GOOGLE_ADS_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-...
GOOGLE_ADS_REFRESH_TOKEN=<refresh-token-with-adwords-scope>

# ── Mapbox ──────────────────────────────────────────────────
# Public token (safe for frontend)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Secret token — BACKEND ONLY
MAPBOX_SECRET_TOKEN=sk.eyJ...

# ── Twilio (SMS / WhatsApp) ──────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── LiveKit (Video / WebRTC) ─────────────────────────────────
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
VITE_LIVEKIT_URL=wss://<project>.livekit.cloud

# ── TravelPayouts / Duffel ───────────────────────────────────
VITE_TRAVELPAYOUTS_MARKER=<marker>
DUFFEL_API_KEY=duffel_live_...

# ── Meta / Facebook ──────────────────────────────────────────
# Public browser pixel/dataset ID. Use the same ID as META_PIXEL_ID unless
# Meta gives you separate datasets for web and server events.
VITE_META_PIXEL_ID=<pixel-id>
VITE_META_GRAPH_VERSION=v25.0
# Optional public Meta app ID for Facebook crawler App Links / Open Graph.
VITE_META_APP_ID=<meta-app-id>
# Public Meta domain verification token from Business Settings > Brand Safety > Domains.
# Paste only the content value from Meta's facebook-domain-verification meta tag.
VITE_META_DOMAIN_VERIFICATION=<meta-domain-verification-token>
# Server-side Conversions API and Ads API secrets (Supabase Edge Functions).
META_PIXEL_ID=<pixel-id>
META_ACCESS_TOKEN=<meta-system-user-or-conversions-api-token>
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v25.0
META_AD_ACCOUNT_ID=act_<ad-account-id>
META_PAGE_ID=<facebook-page-id>
# Meta app OAuth for store owners / admin integrations.
META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret>

# ── App ──────────────────────────────────────────────────────
VITE_APP_URL=https://zivollc.com
VITE_AVIASALES_WL_BASE_URL=https://aviasales.com
# Public-facing canonical origin (used by share-link builders, OG tags, deep links)
VITE_PUBLIC_ORIGIN=https://zivollc.com
# Mobile app store URLs (rendered by smart banners + footer "Get the app" CTAs)
VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.hizovo.app
VITE_IOS_APP_STORE_URL=https://apps.apple.com/us/app/zivos/id6759480121

# ── Web Push / VAPID ─────────────────────────────────────────
# Public key for browser push subscriptions (paired with the private key
# stored as a Supabase function secret VAPID_PRIVATE_KEY)
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# ── WebRTC TURN (live calls / streaming) ─────────────────────
# Comma-separated list of TURN/STUN server URLs (turn:..., turns:..., stun:...)
VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
VITE_WEBRTC_TURN_USERNAME=<turn-username>
VITE_WEBRTC_TURN_CREDENTIAL=<turn-credential>

# ── Sticker Asset CDN ────────────────────────────────────────
# Origin that hosts the sticker pack assets (defaults to public Supabase
# storage bucket; override for self-hosted CDN)
VITE_STICKER_ASSET_ORIGIN=https://<project-ref>.supabase.co/storage/v1/object/public/stickers
