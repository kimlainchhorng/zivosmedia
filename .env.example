# ============================================================
# ZIVO — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Public publishable/anon key (safe to expose in frontend JS)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
# Dedicated zivosoftware.com browser project. Keep this pointed at the
# Zivo software Supabase project, not the main Zivo media project.
VITE_ZIVO_SOFTWARE_SUPABASE_URL=https://ydxztoresbdeoeijhxww.supabase.co
VITE_ZIVO_SOFTWARE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Dedicated zivostravel.com browser project.
VITE_ZIVO_TRAVEL_SUPABASE_URL=https://xbllvmpomorawkcrtbcq.supabase.co
VITE_ZIVO_TRAVEL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Keep false until flight/hotel/car/bus tables, Edge Functions, and secrets are
# migrated from the main Zivo project into the travel project.
VITE_ZIVO_TRAVEL_USE_DEDICATED_BACKEND=false
# Dedicated zivodriver.com browser project. Auth still runs on the main ZIVO
# project; this key only routes Driver data calls to the Driver project.
VITE_ZIVO_DRIVER_SUPABASE_URL=https://yiedlgoxwjmansszdypf.supabase.co
VITE_ZIVO_DRIVER_SUPABASE_PUBLISHABLE_KEY=
# Server-side summary RPC names used by zivo-domain-summary.
ZIVO_DRIVER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ZIVO_TRAVEL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ZIVO_SOFTWARE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ZIVO_DRIVER_SUMMARY_RPC=zivo_driver_share_summary
ZIVO_TRAVEL_SUMMARY_RPC=zivo_travel_share_summary
ZIVO_SOFTWARE_SUMMARY_RPC=zivo_software_share_summary
# Enable only after the analytics-event-track Edge Function is deployed.
VITE_ANALYTICS_EVENT_TRACK_ENABLED=false
# Enable only after notification-manage is deployed and smoke-tested.
VITE_NOTIFICATION_MANAGE_ENABLED=false
# Enable only after social-notification-manage is deployed and smoke-tested.
VITE_SOCIAL_NOTIFICATION_MANAGE_ENABLED=false
# Enable only after push-device-manage is deployed and smoke-tested.
VITE_PUSH_DEVICE_MANAGE_ENABLED=false
# Enable only after talent-invite-notification is deployed and smoke-tested.
VITE_TALENT_INVITE_NOTIFICATION_ENABLED=false
# Enable only after admin-broadcast-notification is deployed and smoke-tested.
VITE_ADMIN_BROADCAST_NOTIFICATION_ENABLED=false
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend-compatible anon JWT for Edge Functions, scripts, and pg_cron auth.
# Keep separate from VITE_SUPABASE_PUBLISHABLE_KEY because Edge Function JWT
# verification and database cron jobs may still require the legacy anon JWT.
SUPABASE_ANON_KEY=eyJ...anon...
# Supabase CLI access token for production readiness checks only.
# Keep real tokens private and rotate them if they are ever exposed.
SUPABASE_ACCESS_TOKEN=sbp_...

# Secret/service role key — BACKEND ONLY, never expose to browser or VITE_ env
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Optional comma-separated preview/staging origins for Supabase Edge Function CORS.
# Leave empty in strict production.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_SUFFIXES=

# ── Stripe ──────────────────────────────────────────────────
# Publishable key (safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key — BACKEND ONLY
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Bakong KHQR / ABA ───────────────────────────────────────────────────────
# Public static merchant KHQR string. Customers can already see this QR, so it
# is safe for frontend use. Used to generate exact-amount ride QR codes.
VITE_KHQR_STATIC_MERCHANT_QR=000201...
# Same static merchant KHQR for Edge Functions to validate the receiving account.
KHQR_STATIC_MERCHANT_QR=000201...
# Supabase Edge Function secret for official Bakong payment verification.
BAKONG_TOKEN=<bakong-open-api-token>
# Optional Telegram receipt bridge for ABA incoming payment messages.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>

# ── Google ──────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# ── Mapbox ──────────────────────────────────────────────────
# Public token (safe for frontend)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Secret token — BACKEND ONLY
MAPBOX_SECRET_TOKEN=sk.eyJ...

# ── Twilio (SMS / WhatsApp) ──────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── LiveKit (Video / WebRTC) ─────────────────────────────────
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
VITE_LIVEKIT_URL=wss://<project>.livekit.cloud

# ── TravelPayouts / Duffel ───────────────────────────────────
VITE_TRAVELPAYOUTS_MARKER=<marker>
DUFFEL_API_KEY=duffel_live_...

# ── Ads / Analytics / Monetization ───────────────────────────
VITE_GOOGLE_ANALYTICS_ID=G-...
VITE_GOOGLE_ADS_ID=AW-...
VITE_GOOGLE_ADS_OAUTH_READY=false
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-...
VITE_ADSENSE_SLOT_HOME_FEED=<adsense-ad-slot-id>
VITE_ADSENSE_SLOT_SEARCH_RESULTS=<adsense-ad-slot-id>
VITE_ADSENSE_SLOT_ARTICLE_INLINE=<adsense-ad-slot-id>
VITE_META_APP_ID=<facebook-app-id>
VITE_META_PIXEL_ID=<pixel-id>
VITE_TIKTOK_PIXEL_ID=<pixel-id>
VITE_X_PIXEL_ID=<pixel-id>
META_ACCESS_TOKEN=<meta-conversions-api-token>
META_PIXEL_ID=<pixel-id>
GOOGLE_ADS_CLIENT_ID=<google-oauth-client-id>
GOOGLE_ADS_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_ADS_REFRESH_TOKEN=<google-ads-refresh-token>
GOOGLE_ADS_CUSTOMER_ID=<customer-id-without-dashes>
GOOGLE_ADS_DEVELOPER_TOKEN=<developer-token>
GOOGLE_ADS_CONVERSION_ACTION_ID_PURCHASE=<conversion-action-id>
GOOGLE_ADS_CONVERSION_ACTION_ID_LEAD=<conversion-action-id>
GOOGLE_ADS_CONVERSION_ACTION_ID_INITIATE_CHECKOUT=<conversion-action-id>
GOOGLE_ADS_CONVERSION_ACTION_ID_SIGN_UP=<conversion-action-id>

# ── App ──────────────────────────────────────────────────────
VITE_APP_URL=https://myzivo.com
VITE_AVIASALES_WL_BASE_URL=https://aviasales.com
# Canonical standalone customer Ride app. Required in production; use a
# exact canonical origin below or a non-root same-origin reverse-proxy path.
# Local development defaults to localhost:5177.
VITE_ZIVO_RIDE_APP_URL=https://ride.zivosmedia.com
# Public-facing canonical origin (used by share-link builders, OG tags, deep links)
VITE_PUBLIC_ORIGIN=https://myzivo.com
# Mobile app store URLs (rendered by smart banners + footer "Get the app" CTAs)
VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.zivo.app
VITE_IOS_APP_STORE_URL=https://apps.apple.com/app/zivo/id<id>

# ── Zivosmedia Identity Hub (BACKEND ONLY) ───────────────────
# Product-app client secrets must be stored only in product backends.
# Zivosmedia stores SHA-256 hashes in public.app_integrations.client_secret_hash.
ZIVO_IDENTITY_ISSUER=https://zivosmedia.com
ZIVO_IDENTITY_CODE_TTL_SECONDS=300
ZIVO_TRAVEL_CLIENT_SECRET=<server-only-secret-stored-in-travel-backend>
ZIVO_DRIVER_CLIENT_SECRET=<server-only-secret-stored-in-driver-backend>
ZIVO_SOFTWARE_CLIENT_SECRET=<server-only-secret-stored-in-software-backend>
ZIVO_CHAT_CLIENT_SECRET=<server-only-secret-stored-in-chat-backend>
ZIVO_RIDE_AUTH_CLIENT_SECRET=<server-only-secret-stored-in-ride-backend>
ZIVO_WEBHOOK_SIGNING_SECRET=<server-only-webhook-hmac-secret>

# ── Web Push / VAPID ─────────────────────────────────────────
# Public key for browser push subscriptions (paired with the private key
# stored as a Supabase function secret VAPID_PRIVATE_KEY)
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# ── WebRTC TURN (live calls / streaming) ─────────────────────
# Comma-separated list of TURN/STUN server URLs (turn:..., turns:..., stun:...)
VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
VITE_WEBRTC_TURN_USERNAME=<turn-username>
VITE_WEBRTC_TURN_CREDENTIAL=<turn-credential>

# ── Sticker Asset CDN ────────────────────────────────────────
# Origin that hosts the sticker pack assets (defaults to public Supabase
# storage bucket; override for self-hosted CDN)
VITE_STICKER_ASSET_ORIGIN=https://<project-ref>.supabase.co/storage/v1/object/public/stickers

# ── AI agents (multi-agent workflow) ─────────────────────────
# DeepSeek API key for `npm run agent:deepseek`. Put the real value in .env.local
# (git-ignored), NOT here. See docs/agent-workflow.md.
DEEPSEEK_API_KEY=sk-...
# Optional: override the DeepSeek API base URL (defaults to https://api.deepseek.com).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Xiaomi MiMo API key for `npm run agent:mimo` (OpenAI-compatible chat API).
# Put the real value in .env.local (git-ignored), NOT here.
MIMO_API_KEY=sk-...
# Optional: override MiMo's base URL / model / API format (defaults shown).
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_API_FORMAT=openai
# MIMO_THINKING=disabled
