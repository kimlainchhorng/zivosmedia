# ============================================================
# ZIVO — Deploy/Production Preflight Environment Template
# Copy to .env.deploy or configure the same values as CI secrets.
# NEVER commit real .env.deploy files or real tokens.
# ============================================================

# Public browser/project values used by build and preview checks.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=<project-ref>
# Required for Cloudflare zivosoftware.com deploys.
VITE_ZIVO_SOFTWARE_SUPABASE_URL=https://ydxztoresbdeoeijhxww.supabase.co
VITE_ZIVO_SOFTWARE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required for Cloudflare zivostravel.com deploys.
VITE_ZIVO_TRAVEL_SUPABASE_URL=https://xbllvmpomorawkcrtbcq.supabase.co
VITE_ZIVO_TRAVEL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Keep false until flight/hotel/car/bus tables, Edge Functions, and secrets are
# migrated from the main Zivo project into the travel project.
VITE_ZIVO_TRAVEL_USE_DEDICATED_BACKEND=false
# Required before any zivosmedia-hosted zivodriver.com browser bundle can route
# Driver data calls to the Driver project. Leave blank to keep data on main.
VITE_ZIVO_DRIVER_SUPABASE_URL=https://yiedlgoxwjmansszdypf.supabase.co
VITE_ZIVO_DRIVER_SUPABASE_PUBLISHABLE_KEY=
# Server-side summary RPC names used by zivo-domain-summary.
ZIVO_DRIVER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ZIVO_TRAVEL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ZIVO_SOFTWARE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ZIVO_DRIVER_SUMMARY_RPC=zivo_driver_share_summary
ZIVO_TRAVEL_SUMMARY_RPC=zivo_travel_share_summary
ZIVO_SOFTWARE_SUMMARY_RPC=zivo_software_share_summary
# Enable only after the analytics-event-track Edge Function is deployed.
VITE_ANALYTICS_EVENT_TRACK_ENABLED=false
# Enable only after notification-manage is deployed and smoke-tested.
VITE_NOTIFICATION_MANAGE_ENABLED=false
# Enable only after social-notification-manage is deployed and smoke-tested.
VITE_SOCIAL_NOTIFICATION_MANAGE_ENABLED=false
# Enable only after push-device-manage is deployed and smoke-tested.
VITE_PUSH_DEVICE_MANAGE_ENABLED=false
# Enable only after talent-invite-notification is deployed and smoke-tested.
VITE_TALENT_INVITE_NOTIFICATION_ENABLED=false
# Enable only after admin-broadcast-notification is deployed and smoke-tested.
VITE_ADMIN_BROADCAST_NOTIFICATION_ENABLED=false

# Backend/deploy values used by cron auth, Edge Function verification, and
# production migration-history checks.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_ACCESS_TOKEN=sbp_...

# Optional backend-only keys needed by deploy scripts and smoke jobs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# AI provider secrets used by bot-ai-handler Edge Function runtime.
DEEPSEEK_API_KEY=sk-...
MIMO_API_KEY=sk-...
# Optional MiMo runtime overrides for OpenAI-compatible endpoint/model behavior.
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_THINKING=disabled
ANTHROPIC_API_KEY=sk-ant-...

# Optional explicit Edge Function URL for channel share previews. Usually this
# can be derived from SUPABASE_URL; set it only when previews need a custom
# function origin or proxy.
CHANNEL_OG_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/channel-og
